  inside cube 0. 0. 0. 50. 50. 50.
end structure

structure TMP.pdb
  number 193
  inside cube 0. 0. 0. 50. 50. 50.
end structure

structure Li.pdb
  number 75
  inside cube 0. 0. 0. 50. 50. 50.
end structure

structure PF6.pdb
  number 75
  inside cube 0. 0. 0. 50. 50. 50.
end structure



