define =
integrator = md
dt         = 0.001
nsteps     = 1000000
comm-grps  = system
energygrps = 
;
nstxout = 0
nstvout = 0
nstfout = 0
nstlog  = 5000
nstenergy = 5000
nstxout-compressed = 5000
compressed-x-grps  = system
;
pbc = xyz
cutoff-scheme = Verlet
coulombtype   = PME
rcoulomb      = 1.2
vdwtype       = cut-off
rvdw          = 1.2
DispCorr      = EnerPres
;
Tcoupl  = V-rescale
tau_t   = 0.5
tc_grps = system
ref_t   = 298.15
;
Pcoupl     = C-rescale
pcoupltype = isotropic
tau_p = 2.0
ref_p = 1.01325
compressibility = 4.5e-5
;
gen_vel  = no
gen_temp = 298.15
gen_seed = -1
;
freezegrps  = 
freezedim   = 
constraints = hbonds
